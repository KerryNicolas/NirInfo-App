# Backend
backend/vendor/
backend/.env
backend/storage/app/public/photos/*
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/views/
# Faux disque créé par les tests (Storage::fake)
backend/storage/framework/testing/
backend/storage/logs/
backend/bootstrap/cache/
!backend/storage/app/public/photos/.gitkeep
# Fichier généré par PHPUnit à chaque exécution des tests
backend/.phpunit.result.cache
# Photos du personnel envoyées depuis l'application (pas du code)
backend/storage/app/public/personnels/
backend/public/storage/personnels/*
# Photos de profil des comptes utilisateurs (données personnelles, pas du code)
backend/storage/app/public/utilisateurs/
backend/public/storage/utilisateurs/

# Frontend
frontend/node_modules/
frontend/dist/

# Archives (peuvent contenir .env, vendor, node_modules) — jamais versionnées
*.zip

# OS
.DS_Store
Thumbs.db
*.swp

# Photos envoyées par les utilisateurs, vues à travers le lien public/storage
backend/public/storage/photos/*
!backend/public/storage/photos/.gitkeep
