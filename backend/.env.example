# Modèle de configuration — copier en ".env" puis adapter les valeurs.
# Ne JAMAIS mettre de vrai mot de passe dans ce fichier : il est versionné.

APP_NAME=NirInfo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Adresse publique de l'API Laravel (sans /api)
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_formation
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=480

# ── Frontend React ──
# Adresse du frontend : liens des emails (activation, mot de passe oublié)
# et origine autorisée par CORS.
FRONTEND_URL=http://localhost:5173
# Autres origines autorisées, séparées par des virgules (facultatif)
CORS_ALLOWED_ORIGINS=
# Domaines du frontend autorisés à utiliser la session (hôte:port, sans http://)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:4173
# Domaine du cookie de session : null en local, ".mondomaine.mg" en production
SESSION_DOMAIN=null
# true dès que le site est servi en https
SESSION_SECURE_COOKIE=false

# ── Emails ──
# MAIL_MAILER=log écrit les emails dans storage/logs au lieu de les envoyer.
# Gmail : MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
#         MAIL_PASSWORD = mot de passe d'application (16 lettres, sans espaces).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=admin@nir-info.mg
MAIL_FROM_NAME="Nir'Info"
